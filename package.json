{
    "name": "@bfmeta/transaction-maker-server",
    "private": true,
    "bin": "index.js",
    "pkg": {
        "scripts": [
            "build/src/*.js"
        ]
    },
    "workspaces": [
        "packages/*"
    ],
    "version": "0.0.0",
    "description": "transaction-maker-server for the third party",
    "scripts": {
        "lsts": "node ./scripts/listAllFile.js",
