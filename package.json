{
    "name": "@bfchain/pc-sdk",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "version": "0.0.0",
    "description": "pc-sdk for the third party",
    "bdkMono": {
        "generateConfigFiles": [
            {
                "packages": "*",
                "type": "mergejson",
                "from": "$ROOT_PROJECT/tsconfig.cjs.json",
                "to": "$PACKAGE/tsconfig.json"
            },
            {
                "packages": "*,-test",
                "type": "jsonfromjs",
                "src": "$ROOT_PROJECT/tsconfig.@types.js",
                "to": "$PACKAGE/tsconfig.@types.json"
            }
        ]
    },
    "scripts": {
        "package": "node ./scripts/package.js",
        "format": "bdk-format -m all",
        "prepare": "yarn mono",
        "mono": "bdk-mono",
        "lsts": "bdk-lsts -p=./tsconfig.json",
        "clear": "node ./scripts/rmBuild.js",
        "dev": "bdk-tsc --build -w",
        "dev:all": "bdk-tsc --build ./tsconfig.all.json -w",
        "build": "bdk-tsc --build ./tsconfig.all.json",
        "rebuild": "yarn clear & yarn build",
        "publ": "lerna publish",
        "publ:type": "yarn mono & node ./scripts/publish-types.js",
        "publ:force": "lerna publish --force-publish"
    },
    "repository": {
        "type": "git",
        "url": "ssh://bnqkl.dev:22/CoreProductCollection/BFChain-PC/_git/BFChain-PC-SDK"
    },
    "author": "BFChain Team",
    "license": "ISC",
    "dependencies": {},
    "devDependencies": {
        "@bfchain/devkit": "^0.9.35",
        "@types/node": "~12.12.70",
        "lerna": "^3.20.2"
    }
}
